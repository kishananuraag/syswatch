<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.barbarian.syswatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Applications/Syswatch.app/Contents/MacOS/syswatch</string>
		<string>--menubar</string>
		<string>--interval-ms</string>
		<string>2000</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/syswatch/app.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/syswatch/app.log</string>
</dict>
</plist>
