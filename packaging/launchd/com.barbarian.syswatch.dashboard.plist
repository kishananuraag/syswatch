<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.barbarian.syswatch.dashboard</string>
	<key>WorkingDirectory</key>
	<string>__HOME__/Documents/projects/syswatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Documents/projects/syswatch/.venv/bin/python3</string>
		<string>dashboard/server.py</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SYSWATCH_LOGS</key>
		<string>__HOME__/Library/Application Support/syswatch/logs</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/syswatch/dashboard.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/syswatch/dashboard.log</string>
</dict>
</plist>
