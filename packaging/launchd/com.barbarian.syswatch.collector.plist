<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.barbarian.syswatch.collector</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Library/Application Support/syswatch/syswatch-collector</string>
		<string>--headless</string>
		<string>--log</string>
		<string>--temp</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SYSWATCH_LOG_DIR</key>
		<string>__HOME__/Library/Application Support/syswatch/logs</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/syswatch/collector.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/syswatch/collector.log</string>
</dict>
</plist>
